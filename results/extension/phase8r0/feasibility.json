  "phase": "8R0",
  "research_question": "RQ6: Can a temporal-adaptive, graph-augmented detector improve detection of historically novel and unseen-creator Ponzi contracts relative to the frozen MulCas reconstruction while retaining high precision?",
  "hypotheses": {
    "H8R1": "Recency-aware training improves later-period generalization relative to equal-weight expanding-history training.",
    "H8R2": "A static EVM control-flow graph representation captures discriminative information not represented adequately by flat opcode counts/N-grams.",
    "H8R3": "A novelty-aware routing mechanism reduces confident false-negative decisions on historically novel contracts.",
    "H8R4": "A temporally trained hybrid of MulCas and the graph view improves F1 and recall relative to frozen MulCas."
